# Build Target (admin, merchant, fmcg, or leave empty for unified build)
VITE_APP_TARGET=

# Vercel Deployment
VERCEL_TOKEN=
VERCEL_TEAM_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=

# Supabase — frontend (browser-safe, RLS-protected only)
VITE_SUPABASE_URL="https://balrpczytusvzzquzqob.supabase.co"
VITE_SUPABASE_ANON_KEY=

# ⚠️ SUPABASE_SERVICE_ROLE_KEY must NEVER be prefixed with VITE_ and must
# NEVER appear in this frontend .env. It belongs only in Supabase Edge
# Function secrets (set via `supabase secrets set`), never in a file
# that ships to Vercel or the browser. See src/lib/supabase.ts for why.

# Africa's Talking Credentials (edge function secrets, not frontend)
AT_API_KEY=
AT_USERNAME=
AT_USSD_CODE=
AT_SANDBOX=true

# Operations
RESTOCK_PHONE=6180
FMCG_ADMIN_SECRET=

# Email Delivery (Resend) — edge function secret
RESEND_API_KEY=
RESEND_FROM_EMAIL="onboarding@resend.dev"

# FMCG Portal URL
VITE_FMCG_PORTAL_URL="https://nx-network-fmcg.vercel.app"
